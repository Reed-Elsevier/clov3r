# Copy to infra/backend.hcl (git-ignored), or paste the `backend_hcl` output
# from infra/bootstrap. Replace <ACCOUNT_ID> with your AWS account ID.
bucket       = "invoiceiq-tfstate-<ACCOUNT_ID>-ap-southeast-1"
key          = "invoiceiq/dev/terraform.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true
