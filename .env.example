# Copy to .env.local (git-ignored) and fill in. Next.js, drizzle-kit and the
# scripts in scripts/ all read .env.local first, then .env.

# PostgreSQL connection string. For the shared AWS RDS dev database, run
# `node infra/scripts/write-env.mjs`: it fills this in (TLS verified against
# the RDS CA bundle). See infra/README.md.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoiceiq

# AWS region for Bedrock (and other AWS SDK clients).
AWS_REGION=ap-southeast-1

# Temporary AWS credentials from your SSO access portal ("Access keys"), used
# locally for Bedrock and by infra/scripts/write-env.mjs. They expire after a
# few hours; paste fresh ones when calls start failing. Never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bedrock model used for anomaly explanations (feat/ai-explanations).
# Final model choice is an open infra decision; keep this swappable.
BEDROCK_MODEL_ID=

# Base URL of the Python Isolation Forest service (services/anomaly-engine).
ANOMALY_ENGINE_URL=http://localhost:8000
